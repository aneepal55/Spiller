# Create this in Google AI Studio from a project whose Billing Tier says Free.
# Do not link a billing account if you want to guarantee that Google cannot charge you.
GEMINI_API_KEY=your_free_tier_key_here

# Optional Replit MCP connection. Replit's MCP uses OAuth 2.1/PKCE.
# Store only the resulting access token here; never expose it to browser code.
REPLIT_MCP_ACCESS_TOKEN=your_replit_oauth_access_token_here

# Official Replit MCP endpoint. Omit this unless you need to override it for testing.
# REPLIT_MCP_URL=https://replit-mcp.com/server/mcp
